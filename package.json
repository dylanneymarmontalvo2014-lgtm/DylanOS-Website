{
  "name": "dylanos-website",
  "private": true,
  "version": "1.0.0",
  "description": "Web oficial de DylanOS — catálogo de descargas Crimson, panel de administración de versión y CLI de publicación.",
  "type": "commonjs",
  "scripts": {
    "dev": "node server.js",
    "test": "node --test tests/*/*.test.js",
    "releases:status": "node tools/releases/cli.mjs status",
    "releases:list": "node tools/releases/cli.mjs list",
    "releases:history": "node tools/releases/cli.mjs history",
    "releases:publish": "node tools/releases/cli.mjs publish",
    "releases:retire": "node tools/releases/cli.mjs retire",
    "releases:delete": "node tools/releases/cli.mjs delete",
    "releases:cleanup": "node tools/releases/cli.mjs cleanup",
    "releases:verify": "node tools/releases/cli.mjs verify",
    "releases:admin:add": "node tools/releases/cli.mjs admin:add"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
