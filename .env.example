# ===== Sistema de versiones DylanOS Crimson =====
# Copia este archivo como .env.local. No confirmes .env.local ni valores reales.

# Proyecto Supabase EXISTENTE. La anon key es pública; service_role es secreta.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SourceForge File Release System (FRS).
# El slug del proyecto es público y se usa en el catálogo y el panel.
SOURCEFORGE_PROJECT=

# Solo la CLI local usa identidad SSH. No configures estas dos variables en
# Vercel ni en código del navegador. Si omites SOURCEFORGE_SSH_KEY, rsync usa
# el agente SSH o la clave predeterminada del sistema.
SOURCEFORGE_USERNAME=
SOURCEFORGE_SSH_HOST=frs.sourceforge.net
# SOURCEFORGE_SSH_KEY=/ruta/absoluta/a/id_ed25519

# Opcionales. Déjalas vacías para usar las URL oficiales derivadas del slug.
# SOURCEFORGE_DOWNLOAD_BASE=https://sourceforge.net/projects/SLUG/files
# SOURCEFORGE_FILE_MANAGER_URL=https://sourceforge.net/projects/SLUG/files/

# Compatibilidad de lectura únicamente para registros históricos que aún
# tengan storage_provider=r2. No habilita cargas nuevas a R2.
# R2_PUBLIC_BASE=https://downloads.example.com

# ===== Conectores de estadísticas de GitHub =====
# Repositorio del que se muestran las estadísticas en la web.
# En local: copia este archivo a "asistente ai/.env" (o exporta las variables).
# En Vercel: Project Settings → Environment Variables.

# Dueño del repositorio
GITHUB_OWNER=dylanneymarmontalvo2014-lgtm

# Nombre del repositorio a medir
GITHUB_REPO=DylanOS

# (Opcional) Token de GitHub para subir el rate limit de 60 a 5000 req/hora.
# Sin token las estadísticas siguen funcionando para un sitio con tráfico normal.
# Crear en: https://github.com/settings/tokens (solo lectura, sin scopes para repos públicos)
# GITHUB_TOKEN=
